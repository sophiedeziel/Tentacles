    def rsc_support_enabled?; end

    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:157
    def running_on_windows?; end

    # Scrubs credentials from error-message text that may contain URLs.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:484
    def sanitize_error_text(text); end

    # Removes credentials from a URL for safe display in logs and error messages.
    # Uses URI.parse for all heavy lifting — no regex on the URL itself.
    #
    # URI::File silently drops userinfo during parsing, so uri.to_s is already
    # clean for file:// URLs. Malformed URLs that fail URI.parse get a safe
    # placeholder. See #5046.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:454
    def sanitize_url_for_display(url); end

    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:150
    def server_bundle_js_file_path; end

    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:71
