# pkg:gem/react_on_rails#lib/react_on_rails/test_helper.rb:4
module ReactOnRails::TestHelper
  class << self
    # Because you will probably want to run RSpec tests that rely on compiled JavaScript assets
    # (typically, your integration/feature specs where `js: true`), you will want to ensure you
    # don't accidentally run tests on missing or stale generated assets. If you did use stale
    # assets, you will get invalid test results as your tests do not use the very latest
    # JavaScript code.
    #
    # Call this method from inside of the `RSpec.configure` block in your `spec/rails_helper.rb`
    # file, passing the config as an argument. You can customize this to your particular needs by
    # replacing any of the default components.
    #
    # RSpec.configure do |config|
    #   ReactOnRails::TestHelper.configure_rspec_to_compile_assets(config)
    #
    # You can pass an RSpec metatag as an list of parameter to this helper method
    # if you want this helper to run on examples other than where `js: true` or
    # `server_rendering: true` (default). The helper will compile generated files at most
    # once per test run.
    #
    # If you do not want to be slowed down by re-compiling generated assets from scratch every test
    # run, you can call `yarn run build:client` (and `yarn run build:server` if doing server
    # rendering) to have the bundler recompile these files in the background, which will be *much*
    # faster. The helper looks for these processes and will abort recompiling if it finds them
    # to be running.
    #
    # See https://github.com/shakacode/react_on_rails/blob/master/docs/oss/building-features/testing-configuration.md
    # for more info
    #
    # Params:
    # config - config for rspec
    # metatags - metatags to add the ensure_assets_compiled check.
    #            Default is :js, :server_rendering, :controller
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper.rb:36
    def configure_rspec_to_compile_assets(config, *metatags); end

    # Main entry point to ensuring assets are compiled. See `configure_rspec_to_compile_assets` for
    # an example of usage.
    #
    # Typical usage passes all params as nil defaults.
    # webpack_assets_status_checker: provide: `up_to_date?`, `whats_not_up_to_date`, `source_path`
    #                         defaults to ReactOnRails::TestHelper::WebpackAssetsStatusChecker
    # webpack_assets_compiler: provide one method: `def compile`
    #                         defaults to ReactOnRails::TestHelper::WebpackAssetsCompiler
    # source_path and generated_assets_full_path are passed into the default webpack_assets_status_checker if you
    #                        don't provide one.
    # webpack_generated_files List of files to check for up-to-date-status, defaulting to
    #                        webpack_generated_files in your configuration
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper.rb:66
    def ensure_assets_compiled(webpack_assets_status_checker: T.unsafe(nil), webpack_assets_compiler: T.unsafe(nil), source_path: T.unsafe(nil), generated_assets_full_path: T.unsafe(nil), webpack_generated_files: T.unsafe(nil)); end
  end
end

# Detects whether development build assets can be reused for tests,
# avoiding redundant compilation when `bin/dev static` is already running.
#
# When `bin/dev static` runs the bundler in watch mode, it writes compiled assets
# to the development output directory (e.g., public/packs). If those assets
# are fresh (newer than all source files) and not HMR artifacts, tests can
# reuse them instead of running a separate build_test_command.
#
# This makes `bundle exec rspec` "just work" when `bin/dev static` is running,
# with no environment variables or extra commands needed.
#
# pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:20
class ReactOnRails::TestHelper::DevAssetsDetector
  # Checks if development assets are reusable for tests.
  #
  # Returns a hash with dev output info if reusable, nil otherwise.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:104
  def check; end

  private

  # Dev assets are fresh if the manifest is newer than all source files.
  # This matches the same mtime comparison used by WebpackAssetsStatusChecker.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:228
  def assets_fresh?(manifest_path); end

  # HMR manifests contain URLs (http://localhost:3035/packs/...) instead of
  # relative paths (/packs/...). Tests can't use HMR assets because they're
  # served from the dev server's memory, not the filesystem.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:206
  def hmr_manifest?(manifest_path); end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:213
  def hmr_url_present?(value); end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:119
  def load_shakapacker_yml; end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:238
  def make_source_file_list(source_path); end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:150
  def manifest_usable?(manifest_path); end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:161
  def print_hmr_warning; end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:199
  def project_root; end

  # Returns dev output details or nil if dev/test already resolve to the same full path.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:130
  def resolve_dev_output(shakapacker_yml); end

  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:193
  def resolve_env_config(yml, env); end

  class << self
    # Attempts to detect and activate development assets for test use.
    #
    # When successful:
    # - Overrides Shakapacker's test config to point at dev output
    # - Clears manifest cache so tests read the dev manifest
    # - Returns true
    #
    # When dev assets aren't usable (HMR mode, stale, missing):
    # - Returns false with no side effects
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:35
    def try_activate_dev_assets!; end

    private

    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:56
    def apply_shakapacker_override!(result); end

    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:89
    def override_config_value!(config_data, key, value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:80
    def print_activation_message(result); end

    # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:52
    def reset_hmr_warning_state!; end
  end
end

# pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:22
ReactOnRails::TestHelper::DevAssetsDetector::HMR_HINT = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/test_helper/dev_assets_detector.rb:21
ReactOnRails::TestHelper::DevAssetsDetector::HMR_WARNING_PRINTED = T.let(T.unsafe(nil), Symbol)

# pkg:gem/react_on_rails#lib/react_on_rails/test_helper/ensure_assets_compiled.rb:5
class ReactOnRails::TestHelper::EnsureAssetsCompiled
  # pkg:gem/react_on_rails#lib/react_on_rails/test_helper/ensure_assets_compiled.rb:17
  def initialize(webpack_assets_status_checker: T.unsafe(nil), webpack_assets_compiler: T.unsafe(nil)); end

  # Several Scenarios:
  # 1. No static asset watch process and files are missing or out of date.
  # 2. Only the HMR process is running for the server bundle.
  # 3. For whatever reason, the watch processes are running, but some clean script removed
  #    the generated bundles.
