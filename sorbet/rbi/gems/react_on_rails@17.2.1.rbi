    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:323
    def detect_package_manager_from_package_json; end

    # pkg:gem/react_on_rails#lib/react_on_rails/utils.rb:127
    def handle_missing_manifest_entry(bundle_name, is_server_bundle); end

    # Replaces query values with [REDACTED], keeping keys for diagnostics.
