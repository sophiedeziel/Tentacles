    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1827
    def signal_process_group(pgid, signal); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1814
    def signalable_pgid(pgid); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1745
    def spawn_overmind_command(args); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1969
    def stale_cleanup_candidates(root); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:2332
    def static_procfile_description; end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:2184
    def stringify_config_keys(hash); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3219
    def sync_renderer_port_and_url; end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1772
    def terminate_overmind_command(pid); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1595
    def unprobeable_endpoint_blockers(endpoints); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1599
    def unprobeable_endpoint_message(path); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1211
    def unreachable_owner_message(view, session); end

    # Uses URI.parse so a short port isn't matched as a substring of a
    # longer one (e.g. ":80" inside ":3800"). Malformed URLs fall back to
    # "no mismatch detected" rather than crashing; the warn-path is only
    # advisory.
    #
    # Treats a URL without an explicit port as a mismatch: URI.parse would
    # otherwise return the scheme default (80 for http, 443 for https),
    # which would silently match `RENDERER_PORT=80` / `=443` — a misconfig
    # worth flagging rather than hiding.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3330
    def url_port_mismatch?(url, port); end

    # Validates the parsed shape before anything reads a key. `JSON.parse`
    # happily returns a String, an Integer or nil for valid-but-wrong
    # documents (`"x"`, `7`, `null`), so the Hash check has to come first -
    # otherwise a well-formed but meaningless file would raise
    # NoMethodError instead of being rejected as untrusted state.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1121
    def valid_dev_session_document?(data); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3215
    def valid_port_string?(value); end

    # Deliberately stricter than #valid_session_pid? above: this value IS
    # signalled, and `Process.kill(sig, -1)` broadcasts to every process the
    # user may signal. The asymmetry is load-bearing - do not harmonise it.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1159
    def valid_session_pgid?(value); end

    # `pid` is used only for identity and display (see
    # #unreachable_owner_message), never for signalling, so every positive
    # value is legitimate - including 1, which is exactly what `bin/dev`
    # gets in a minimal Docker dev container with no init wrapper. Rejecting
    # it there disabled the whole mechanism and made every kill refuse.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1137
    def valid_session_pid?(value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1145
    def valid_session_ports?(value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1152
    def valid_session_root?(value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1141
    def valid_session_socket?(value); end

    # Cleanup runs only once verification has fully succeeded. Removing the
    # session file first destroyed the retry path: it carries the ports this
    # run actually selected, so deleting it on the way to reporting
    # :unverified meant the retry fell back to a re-derived guess - exactly
    # the fidelity `selected_session_ports` exists to provide, lost on the
    # one path where it matters most. It also made `print_kill_failure` tell
    # the user to remove a file that was already gone.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1289
    def verify_owner_shutdown(view, pgid, endpoints); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3437
    def wait_for_app_route(port, request_path); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1757
    def wait_for_overmind_command(pid, timeout_secs); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1788
    def wait_for_overmind_group_exit(pid, timeout_secs, reaped); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1974
    def wait_until(timeout_secs); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:779
    def warn_dev_session_contended(file, path, root); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:774
    def warn_dev_session_unrecorded(reason); end

    # The env var used to configure the Pro node renderer URL was renamed
    # from `RENDERER_URL` to `REACT_RENDERER_URL`. Two mid-migration states
    # are worth flagging:
    #
    #   1. Only `RENDERER_URL` is set — Rails falls back to the default
    #      `http://localhost:3800` silently (which doesn't exist in most
    #      container setups).
    #   2. Both are set but disagree — the Pro initializer and any tooling
    #      that reads one but not the other will silently disagree. The
    #      gem does not read either env var directly; the user's Pro
    #      initializer picks one (`config.renderer_url = ENV[...]`).
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3023
    def warn_if_legacy_renderer_url_env_used; end

    # Mirrors warn_if_renderer_url_will_be_overridden so users notice when a
    # pre-existing PORT or SHAKAPACKER_DEV_SERVER_PORT is replaced by the
    # base-port-derived value.
    #
    # Asymmetry vs. `overwrite_invalid_port_env` is intentional: base-port
    # mode replaces the user's explicit value with a derived one (so we
    # warn on any non-matching value), while explicit mode honors valid
    # user input and only warns when it must rewrite an invalid value.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3153
    def warn_if_port_will_be_overridden(var_name, derived_port); end

    # Base port mode overrides REACT_RENDERER_URL (and the legacy
    # RENDERER_URL) to point at a local renderer derived from the base
    # port. Warn whenever an explicitly-set URL doesn't exactly match the
    # derived one so users notice — including the "localhost with a
    # different port" case, which is a real misconfiguration (Rails would
    # target one port, the renderer another).
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3167
    def warn_if_renderer_url_will_be_overridden(var_name, derived_url); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:2406
    def warn_if_shakapacker_version_too_old; end

    # URL without a port is a silent misconfig: the node renderer process
    # binds to the Procfile default (3800) while Rails targets whatever
    # port is in the URL. Warn so the mismatch is visible, but only for
    # local URLs where this process actually controls the renderer.
    #
    # Remote portless URLs (e.g. `REACT_RENDERER_URL=http://renderer.internal`)
    # are intentionally excluded: this process doesn't launch remote
    # renderers, so scheme-default ports (80/443) may be the correct target
    # behind a reverse proxy. Remote-side port mismatches are a deployment
    # concern, not something bin/dev can diagnose safely.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3275
    def warn_url_without_port(url); end

    # Wraps a foreground process-manager run so `bin/dev kill` has a
    # trustworthy, worktree-scoped handle on it. Ordinary session-document
    # bookkeeping failures do not block startup - the kill path degrades to
    # port-attributed cleanup instead. Failure or contention on the fixed
    # ownership lock is different: a kill may be acting on the previous
    # session, so an unrecorded replacement must not start.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:628
    def with_dev_session; end

    # `lsof -a -p PID -d cwd -Fn` prints the process's working directory in
    # a machine-readable form. Returning nil (tooling missing, permission
    # denied, unparsable) means "not attributable", which keeps the pid out
    # of the signal set.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1957
    def working_directory_for_pid(pid); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:682
    def write_claimed_dev_session(file, path, root); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:729
    def write_dev_session(path, root); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:3515
    def wsl?; end
  end
end

# Markers that identify an app root when a command is run from a
# subdirectory. Checked nearest-first while walking up from the cwd.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:101
ReactOnRails::Dev::ServerManager::APP_ROOT_MARKERS = T.let(T.unsafe(nil), Array)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:35
ReactOnRails::Dev::ServerManager::CLEAN_SHAKAPACKER_ENVIRONMENTS = T.let(T.unsafe(nil), Array)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:108
ReactOnRails::Dev::ServerManager::DEV_SERVER_AND_TESTING_DOCS_URL = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:97
ReactOnRails::Dev::ServerManager::DEV_SESSION_CLAIM_ATTEMPTS = T.let(T.unsafe(nil), Integer)

# O_NOFOLLOW so a symlink planted at the session path fails loudly rather
# than having its target silently truncated. `overmind_endpoint_owned?`
# resolves realpath for the same reason on the read side.
# Windows also requires binary mode before Ruby honors SHARE_DELETE. Both
# the old session handle and the tempfile remain open across the atomic
# rename, and the published handle remains open when its path is deleted.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:60
ReactOnRails::Dev::ServerManager::DEV_SESSION_DELETE_SHARING_FLAGS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:71
ReactOnRails::Dev::ServerManager::DEV_SESSION_LOCK_CREATE_FLAGS = T.let(T.unsafe(nil), Integer)

# Opening an existing fixed lock must remain separate from creating one:
# including CREAT here would bypass the bounded CREAT|EXCL race below.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:65
ReactOnRails::Dev::ServerManager::DEV_SESSION_LOCK_OPEN_FLAGS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:42
ReactOnRails::Dev::ServerManager::DEV_SESSION_LOCK_RELATIVE_PATH = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:68
ReactOnRails::Dev::ServerManager::DEV_SESSION_LOCK_WRITE_FLAGS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:61
ReactOnRails::Dev::ServerManager::DEV_SESSION_OPEN_FLAGS = T.let(T.unsafe(nil), Integer)

# The read side needs the same O_NOFOLLOW guarantee as the write side: it
# is the path that leads to signalling, so a symlink here is worth more to
# an attacker than one on the write path. O_NONBLOCK additionally keeps a
# FIFO planted at this path from blocking the open forever - without it
# the "must be a regular file" check below is unreachable, because the
# open never returns.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:78
ReactOnRails::Dev::ServerManager::DEV_SESSION_READ_FLAGS = T.let(T.unsafe(nil), Integer)

# Per-app-directory run state written by `bin/dev` and consumed by
# `bin/dev kill`. See the "Scoped dev shutdown" section further down.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:41
ReactOnRails::Dev::ServerManager::DEV_SESSION_RELATIVE_PATH = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:43
ReactOnRails::Dev::ServerManager::DEV_SESSION_SCHEMA = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:107
ReactOnRails::Dev::ServerManager::DOCS_BASE_URL = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:33
ReactOnRails::Dev::ServerManager::HELP_FLAGS = T.let(T.unsafe(nil), Array)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:37
ReactOnRails::Dev::ServerManager::OPEN_BROWSER_POLL_INTERVAL = T.let(T.unsafe(nil), Float)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:36
ReactOnRails::Dev::ServerManager::OPEN_BROWSER_WAIT_TIMEOUT = T.let(T.unsafe(nil), Integer)

# A phase controls every discovered socket under one shared deadline.
# Without this second bound, N wedged endpoints each consumed a fresh
# command timeout and made shutdown latency grow linearly with N.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:89
ReactOnRails::Dev::ServerManager::OVERMIND_CONTROL_BATCH_TIMEOUT_SECS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:91
ReactOnRails::Dev::ServerManager::OVERMIND_CONTROL_RUNNER = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:90
ReactOnRails::Dev::ServerManager::OVERMIND_CONTROL_TERMINATION_GRACE_SECS = T.let(T.unsafe(nil), Integer)

# Bounded budget for an Overmind control command and for each cleanup
# phase after that budget expires. The launcher execs the selected
# Overmind binary so the isolated process-group leader is the real
# control client, not a wrapper that can die before reaping its child.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:85
ReactOnRails::Dev::ServerManager::OVERMIND_CONTROL_TIMEOUT_SECS = T.let(T.unsafe(nil), Integer)

# Bounded budget for the Overmind control-socket probe. `UNIXSocket.new`
# blocks indefinitely when the accept queue is full or the server is
# paused, which would hang `bin/dev kill` inside an otherwise bounded
# shutdown loop. Mirrors FileManager::SOCKET_PROBE_TIMEOUT_SECS.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:53
ReactOnRails::Dev::ServerManager::OVERMIND_PROBE_TIMEOUT_SECS = T.let(T.unsafe(nil), Float)

# Shutdown outcomes that must never be reported as success: `bin/dev kill`
# exits non-zero on these, and `bin/dev clean` refuses to delete anything.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:105
ReactOnRails::Dev::ServerManager::SHUTDOWN_FAILURE_STATUSES = T.let(T.unsafe(nil), Array)

# Grace given to the forceful stop (`overmind kill` / SIGKILL) before giving up.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:47
ReactOnRails::Dev::ServerManager::SHUTDOWN_KILL_GRACE_SECS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:48
ReactOnRails::Dev::ServerManager::SHUTDOWN_POLL_INTERVAL_SECS = T.let(T.unsafe(nil), Float)

# Grace given to a graceful stop (`overmind quit` / SIGTERM) before escalating.
#
# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:45
ReactOnRails::Dev::ServerManager::SHUTDOWN_TERM_GRACE_SECS = T.let(T.unsafe(nil), Integer)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:109
ReactOnRails::Dev::ServerManager::TESTING_CONFIGURATION_DOCS_URL = T.let(T.unsafe(nil), String)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:34
ReactOnRails::Dev::ServerManager::TEST_WATCH_MODES = T.let(T.unsafe(nil), Array)

# pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:8
module ReactOnRails::Dev::ServerMode
  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:97
    def details(mode); end

    # The fallback preserves legacy HMR wording when no Shakapacker config can be read.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:79
    def detect(config_path = T.unsafe(nil), fallback: T.unsafe(nil)); end

    # This is intentionally narrower than detect: missing, empty, or unparseable config falls back to :hmr for
    # legacy bin/dev help text, but only an explicit HMR config should trigger HMR-specific doctor warnings.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:85
    def hmr_enabled?(config_path = T.unsafe(nil)); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:89
    def text(mode, key); end

    private

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:186
    def boolean_config(value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:107
    def detect_from_config(config_path); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:159
    def detect_from_dev_server_config(dev_server); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:130
    def dev_server_config(config); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:137
    def dev_server_section(environment_config); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:177
    def hmr_config(value); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:202
    def normalize_mode(mode); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:115
    def parse_config(config_path); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:103
    def shakapacker_config_path; end

    # nil/false read as "no dev server", matching Shakapacker, which treats a blank dev_server as
    # absent. Any other non-mapping value (e.g. `dev_server: true`) is a misconfiguration worth
    # surfacing before falling back to Shakapacker's live-reload default.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_mode.rb:150
    def warn_unless_blank_dev_server(dev_server); end
  end
end

