# Patterns that indicate a file likely uses client-side features.
# Used as a heuristic warning — false positives (e.g., patterns in comments) are acceptable
# because this is a warning, not an error.
#
# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:250
ReactOnRails::PacksGenerator::CLIENT_API_PATTERN = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:30
ReactOnRails::PacksGenerator::COMPONENT_EXTENSIONS = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:29
ReactOnRails::PacksGenerator::CONTAINS_CLIENT_OR_SERVER_REGEX = T.let(T.unsafe(nil), Regexp)

# Longer than any realistic pack generation; LOCK_NB still gates the actual clear.
#
# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:41
ReactOnRails::PacksGenerator::GENERATED_PACKS_LOCK_TTL_SECONDS = T.let(T.unsafe(nil), Integer)

# Auto-registration requires nested_entries support which was added in 7.0.0
# Note: The gemspec requires Shakapacker >= 6.0 for basic functionality
#
# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:39
ReactOnRails::PacksGenerator::MINIMUM_SHAKAPACKER_VERSION_FOR_AUTO_BUNDLING = T.let(T.unsafe(nil), String)

# import/extensions suppressions are needed when generated imports include an explicit .js extension.
#
# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:36
ReactOnRails::PacksGenerator::SERVER_BUNDLE_IMPORT_EXTENSION_COMMENT_EXTENSIONS = T.let(T.unsafe(nil), Array)

# Fallback order when the configured server bundle file is missing. Keep .jsx before
# TypeScript extensions as the closest migration fallback for apps moving from JS/JSX to TS.
# The configured extension is excluded, so server-bundle.js tries .jsx, .ts, .tsx, ...
#
# pkg:gem/react_on_rails#lib/react_on_rails/packs_generator.rb:34
ReactOnRails::PacksGenerator::SERVER_BUNDLE_SOURCE_EXTENSIONS = T.let(T.unsafe(nil), Array)

