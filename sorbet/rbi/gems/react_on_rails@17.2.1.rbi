# Parses the length-prefixed wire format used between Node renderer and Ruby.
#
# Wire format per chunk:
#   <metadata JSON>\t<content byte length hex>\n<raw content bytes>
#
# Used by both streaming (Pro) and non-streaming (OSS) paths.
# Strict protocol parser — any format violation raises an error.
#
# pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:14
class ReactOnRails::LengthPrefixedParser
  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:44
  def initialize; end

  # True if the parser encountered a protocol error.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:90
  def error?; end

  # Appends bytes to buffer and yields complete chunks as they become available.
  # Yields Hash: { "html" => content, ...metadata }
  # Raises on protocol errors (bad JSON, bad hex, missing tab).
  # After an error, the parser enters :error state and all subsequent calls are no-ops.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:60
  def feed(chunk, &block); end

  # Called when the stream ends to detect truncated responses.
  # Logs a warning if the buffer still has unconsumed bytes (partial header or content).
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:80
  def flush; end

  private

  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:110
  def parse_length_prefixed_header(header, tab_idx); end

  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:166
  def parse_object_payload(raw_content); end

  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:96
  def try_parse_header; end

  # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:133
  def try_read_content; end

  class << self
    # Parses a complete length-prefixed result string that must contain exactly one chunk.
    # Used by the non-streaming rendering path where ExecJS/node renderer returns a single result.
    # Returns a single Hash: { "html" => String|nil, "consoleReplayScript" => "...", ... }
    # Raises if the input contains zero or more than one chunk.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/length_prefixed_parser.rb:29
    def parse_one_chunk_result(str); end
  end
end

