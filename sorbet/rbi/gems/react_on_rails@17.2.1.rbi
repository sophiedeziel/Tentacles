  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:542
  def wildcard_or_x_range?; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:565
  def workspace_protocol?; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:455
  def yarn_lock; end

  private

  # Check if a version string represents a local path or URL
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:618
  def local_path_or_url_version?(version); end

  # Try yarn.lock first, then package-lock.json, then the other package managers'
  # lockfiles (pnpm-lock.yaml, bun.lock), which live in the same directory as package.json.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:603
  def lockfile_version(package_name); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:698
  def package_installed?(package_name); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:705
  def package_json_contents; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:709
  def parsed_package_contents; end

  # Resolve version from lockfiles if available, otherwise use package.json version
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:587
  def resolve_version(package_json_version, package_name); end

  # Parse version from package-lock.json
  # Supports both v1 (dependencies) and v2/v3 (packages) formats
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:669
  def version_from_package_lock(package_name); end

  # Parse version from yarn.lock
  # Looks for entries like:
  #   react-on-rails@^16.1.1:
  #     version "16.1.1"
  # The pattern ensures exact package name match to avoid matching similar names
  # (e.g., "react-on-rails" won't match "react-on-rails-pro")
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:631
  def version_from_yarn_lock(package_name); end

  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:457
    def build; end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:461
    def package_json_path; end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:472
    def package_lock_path; end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:465
    def yarn_lock_path; end
  end
end

# Semver uses - to separate pre-release, but RubyGems use .
# Possessive quantifiers (++) keep matching linear on adversarial inputs (e.g. a version
# string of thousands of digits): a digit run never needs to backtrack for the following
# "." to match, so the semantics are unchanged.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:22
ReactOnRails::VersionChecker::VERSION_PARTS_REGEX = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/version_syntax_converter.rb:6
class ReactOnRails::VersionSyntaxConverter
  # pkg:gem/react_on_rails#lib/react_on_rails/version_syntax_converter.rb:14
  def npm_to_rubygem(npm_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_syntax_converter.rb:7
  def rubygem_to_npm(rubygem_version = T.unsafe(nil)); end
end

module ReactOnRailsHelper
  include ::ReactOnRails::Utils::Required
  include ::ReactOnRails::ProHelper
  include ::ReactOnRails::FontHelper
  include ::ReactOnRails::Helper
end
