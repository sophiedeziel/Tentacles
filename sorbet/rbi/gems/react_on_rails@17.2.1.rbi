    #
    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:1176
    def dev_session_replaced?(path, file); end

    # pkg:gem/react_on_rails#lib/react_on_rails/dev/server_manager.rb:937
    def dev_session_view(root); end

