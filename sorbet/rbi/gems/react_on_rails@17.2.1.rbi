# Responsible for checking versions of rubygem versus yarn node package
# against each other at runtime.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:9
class ReactOnRails::VersionChecker
  include ::ReactOnRails::ShakapackerConfigHelpers
  include ::ReactOnRails::RscRspackSupport

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:27
  def initialize(node_package_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:16
  def node_package_version; end

  # Validates version and package compatibility.
  # Raises ReactOnRails::Error if:
  # - package.json file is not found
  # - Both react-on-rails and react-on-rails-pro packages are installed
  # - Pro gem is installed but using react-on-rails package
  # - Pro package is installed but Pro gem is not installed
  # - Non-exact version is used
  # - Versions don't match
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:39
  def validate_version_and_package_compatibility!; end

  private

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:270
  def detected_rspack_version_for_rsc; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:429
  def gem_version; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:445
  def gem_version_parts; end

  # Returns the npm-formatted version for install commands.
  # For Pro packages, prefers ReactOnRailsPro::VERSION when available.
  #
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:435
  def npm_version_for_package(package_name); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:303
  def package_dependency_spec(package_name); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:449
  def package_json_location; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:396
  def rsc_rspack_compound_static_clause_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:381
  def rsc_rspack_hyphen_range_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:358
  def rsc_rspack_major_shorthand_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:349
  def rsc_rspack_open_lower_bound_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:328
  def rsc_rspack_or_range_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:333
  def rsc_rspack_single_range_below_minimum?(rspack_version, rspack_major_version = T.unsafe(nil)); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:367
  def rsc_rspack_upper_bound_below_minimum?(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:307
  def rsc_rspack_version_error(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:316
  def rsc_rspack_version_provably_incompatible?(rspack_version, rspack_major_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:324
  def rsc_static_rspack_version_spec(rspack_version); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:287
  def rsc_support_enabled?; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:195
  def validate_exact_version!; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:117
  def validate_no_duplicate_packages!(has_base_package, has_pro_package); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:78
  def validate_package_gem_compatibility!; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:49
  def validate_package_json_exists!; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:89
  def validate_packages_installed!(has_base_package, has_pro_package); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:139
  def validate_pro_gem_uses_pro_package!(is_pro_gem, has_pro_package); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:167
  def validate_pro_package_has_pro_gem!(is_pro_gem, has_pro_package); end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:256
  def validate_rsc_rspack_version!; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:227
  def validate_version_match!; end

  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:420
  def warn_undetermined_rsc_rspack_version(rspack_version); end

  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:23
    def build; end
  end
end

# Parsers for the lockfile formats that NodePackageVersion#resolve_version consults beyond
# Yarn classic and package-lock.json: pnpm-lock.yaml, bun.lock, and Yarn Berry's YAML
# yarn.lock (issue #5049). Semantics deliberately mirror the pre-existing parsers: entries
# are found by package name, and any unreadable or unrecognized lockfile simply yields nil
# so resolution falls back to the package.json version.
#
# The binary bun.lockb is intentionally NOT parsed (undocumented format); projects still on
# it resolve from package.json until they migrate to bun's text lockfile
# (bun install --save-text-lockfile --frozen-lockfile --lockfile-only, bun >= 1.1.39).
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:19
module ReactOnRails::VersionChecker::LockfileResolution
  class << self
    # Every version of +package_name+ that the lockfiles in +dir+ resolve, transitive copies
    # included. .version answers "what did package.json's direct dependency resolve to"; this
    # answers "which copies get installed", so a security check sees a vulnerable nested copy
    # (react-server-dom-webpack arrives through react-on-rails-rsc, not package.json).
    # Unreadable lockfiles contribute nothing. Returns a unique Array of version Strings.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:43
    def all_versions(dir, package_name); end

    # Yarn Berry (yarn 2+) yarn.lock content, dispatched from version_from_yarn_lock when the
    # __metadata marker is present. Returns a version String or nil.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:54
    def berry_yarn_version(content, package_name); end

    # A malformed, unreadable, or unexpectedly shaped lockfile must behave exactly like a
    # missing one (package.json fallback), mirroring the JSON::ParserError rescue the
    # package-lock.json parser has always had — never crash the Rails initializer.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:61
    def guard; end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:72
    def log_ignored(error); end

    # Resolve the installed version from pnpm-lock.yaml or bun.lock in +dir+ (the directory
    # containing the package.json being checked). Returns a version String or nil.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:22
    def version(dir, package_name); end
  end
end

# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:324
ReactOnRails::VersionChecker::LockfileResolution::ALL_VERSION_READERS = T.let(T.unsafe(nil), Hash)

# Yarn Berry yarn.lock (real YAML; entry shape is identical across __metadata versions
# 4-8, i.e. yarn 2 through yarn 4). Mirrors the Yarn classic parser's semantics: the
# first entry keyed by this package name wins.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:227
module ReactOnRails::VersionChecker::LockfileResolution::BerryYarnLockfile
  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:244
    def all_versions(content, package_name); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:258
    def entry_for?(key, package_name); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:228
    def version(content, package_name); end
  end
end

# bun.lock — bun's text lockfile (lockfileVersion 0 in bun 1.1.39, 1 in bun 1.2-1.3,
# 2 in bun 1.4+; same on-disk shape throughout). The file is JSONC: strict JSON.parse
# fails on its trailing commas, so comments and trailing commas are stripped first.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:176
module ReactOnRails::VersionChecker::LockfileResolution::BunLockfile
  class << self
    # packages is keyed by install path ("name", "parent/name"); entry[0] is "name@version".
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:187
    def all_versions(path, package_name); end

    # String-aware JSONC-to-JSON: comments and trailing commas are only stripped OUTSIDE
    # string literals, so values like "x,]" or "https://..." can never be corrupted.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:208
    def jsonc_to_json(content); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:177
    def version(path, package_name); end
  end
end

# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:203
ReactOnRails::VersionChecker::LockfileResolution::BunLockfile::BLOCK_COMMENT = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:202
ReactOnRails::VersionChecker::LockfileResolution::BunLockfile::LINE_COMMENT = T.let(T.unsafe(nil), Regexp)

# One complete JSON string literal (escape-aware), a // line comment, a /* */ block
# comment, and a trailing comma directly before } or ].
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:201
ReactOnRails::VersionChecker::LockfileResolution::BunLockfile::STRING_LITERAL = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:204
ReactOnRails::VersionChecker::LockfileResolution::BunLockfile::TRAILING_COMMA = T.let(T.unsafe(nil), Regexp)

# Yarn classic yarn.lock: one block per resolved copy, keyed by its selectors
# ("name@^1.0.0", "name@~1.0.2":) with an indented version "1.0.3" line. An npm alias
# selector ("flight@npm:name@19.3.0") names the real package after "npm:".
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:268
module ReactOnRails::VersionChecker::LockfileResolution::ClassicYarnLockfile
  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:269
    def all_versions(path, package_name); end
  end
end

# package-lock.json v2/v3 keys every copy by install path ("node_modules/name",
# "node_modules/parent/node_modules/name"); an npm alias installs under the alias path and
# records the real package in "name". v1 nests copies under dependencies, and records an
# alias's real package in its version ("flight": { "version": "npm:name@1.2.3" }).
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:292
module ReactOnRails::VersionChecker::LockfileResolution::NpmLockfile
  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:293
    def all_versions(path, package_name); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:306
    def v1_versions(dependencies, package_name); end
  end
end

# pnpm-lock.yaml. Handles lockfileVersion 5.x (pnpm <= 7: bare version strings), 6.0
# (pnpm 8: {specifier, version} objects), and 9.0 (pnpm 9/10: importers section),
# including the pnpm 11 multi-document form where an env document precedes the project
# document.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:82
module ReactOnRails::VersionChecker::LockfileResolution::PnpmLockfile
  class << self
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:104
    def all_versions(path, package_name); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:122
    def copy_version(key, entry, key_pattern, package_name); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:131
    def dependencies(doc); end

    # YAML.safe_load would return only the FIRST document of a pnpm 11 multi-document
    # lockfile — the env document, which itself carries an importers section (with
    # configDependencies/packageManagerDependencies under ".", never dependencies), so a
    # first-match scan would pick it and resolution would come up empty. pnpm always writes
    # the project document last (writeEnvLockfile prepends the env doc on every write), so
    # scan the stream from the end. permitted_classes: some pnpm versions write unquoted
    # ISO timestamps (a time: map), which Psych types as Date/Time and safe parsing would
    # otherwise reject.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:145
    def project_document(path); end

    # YAML.safe_load_stream exists only from Psych 5.2.5 (Ruby 3.4 ships 5.2.2). Older Psych
    # parses the stream and safe-loads each document, which keeps the same alias and class
    # restrictions.
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:153
    def safe_load_documents(content); end

    # lockfileVersion >= 6: "16.6.0(react-dom@19.3.0(react@19.3.0))(react@19.3.0)" -> "16.6.0"
    # lockfileVersion 5.x:  "16.6.0_react@19.3.0" -> "16.6.0"
    #
    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:165
    def strip_peer_suffix(version); end

    # pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:83
    def version(path, package_name); end
  end
end

# Keys under packages/snapshots name every installed copy:
#   9.0: "name@1.2.3" or "name@1.2.3(peer@4.5.6)"; 6.0: "/name@1.2.3(...)"; 5.x: "/name/1.2.3_peer@4.5.6"
#   5.x and 6.0 from a non-default registry: "registry.example.com/name/1.2.3",
#   "localhost+4873/name/1.2.3", or "registry.example.com/name@1.2.3"
# Tarball, git, and file: copies are returned as their whole key, so callers report them as unknown
# instead of skipping them or misreading a tarball name such as "19.3.1.tgz" as a version. 9.0 keys
# them as "name@https://...tgz(peer@4.5.6)"; 5.x and 6.0 key them by source ("github.com/org/repo/sha",
# "file:vendor/pkg.tgz") and record the package only in the entry's name.
#
# pkg:gem/react_on_rails#lib/react_on_rails/version_checker/lockfile_resolution.rb:102
ReactOnRails::VersionChecker::LockfileResolution::PnpmLockfile::PLAIN_VERSION = T.let(T.unsafe(nil), Regexp)

# pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:454
class ReactOnRails::VersionChecker::NodePackageVersion
  # pkg:gem/react_on_rails#lib/react_on_rails/version_checker.rb:479
