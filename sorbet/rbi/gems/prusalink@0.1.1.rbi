# Faraday middleware for HTTP Digest authentication, the scheme PrusaLink uses.
#
# The first request goes out unsigned. When the printer answers 401 with a Digest challenge,
# the middleware signs the request and sends it again. It keeps the challenge, so later
# requests are signed up front and only retry when the printer rotates its nonce.
#
# @example
#   Faraday.new("http://prusa-mk4.local") do |f|
#     f.use Prusalink::DigestAuth, "maker", "password"
#   end
#
# pkg:gem/prusalink#lib/prusalink/digest_auth.rb:18
class Prusalink::DigestAuth < ::Faraday::Middleware
  # pkg:gem/prusalink#lib/prusalink/digest_auth.rb:22
  sig { params(app: T.untyped, username: ::String, password: ::String).void }
  def initialize(app, username, password); end

  # pkg:gem/prusalink#lib/prusalink/digest_auth.rb:31
  def call(env); end

  private

  # pkg:gem/prusalink#lib/prusalink/digest_auth.rb:64
  def challenged?(response); end

  # Streams (file uploads) would be sent twice if the first attempt bounced off the challenge.
  # A bodyless HEAD to the same URL fetches the challenge first, so the upload is signed up front.
  #
  # pkg:gem/prusalink#lib/prusalink/digest_auth.rb:52
  def preflight(env); end

  # pkg:gem/prusalink#lib/prusalink/digest_auth.rb:68
  def sign(env); end
end

# Prusalink exceptions
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:6
module Prusalink::Exceptions; end

# The credentials were refused (HTTP 401/403)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:10
class Prusalink::Exceptions::AuthenticationError < ::Prusalink::Exceptions::Error; end

# The request can't be processed because of invalid inputs (HTTP 400)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:12
class Prusalink::Exceptions::BadRequestError < ::Prusalink::Exceptions::Error; end

# The printer's state doesn't allow the request, e.g. pausing an idle printer (HTTP 409)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:20
class Prusalink::Exceptions::ConflictError < ::Prusalink::Exceptions::Error; end

# The printer could not be reached (connection refused, host unreachable, DNS failure, ...)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:34
class Prusalink::Exceptions::ConnectionError < ::Prusalink::Exceptions::Error; end

# Base error.
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:8
class Prusalink::Exceptions::Error < ::StandardError; end

# The printer encountered an unexpected condition (HTTP 500)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:24
class Prusalink::Exceptions::InternalServerError < ::Prusalink::Exceptions::Error; end

# The printer answered with a body that isn't valid JSON
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:32
class Prusalink::Exceptions::InvalidResponseError < ::Prusalink::Exceptions::Error; end

# Credentials are missing from the configuration. Set them using `Prusalink.configure()`
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:14
class Prusalink::Exceptions::MissingCredentialsError < ::Prusalink::Exceptions::Error; end

# No client is configured for the current thread. Use `Prusalink.configure()` or `Client#use`
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:16
class Prusalink::Exceptions::NotConfiguredError < ::Prusalink::Exceptions::Error; end

# The resource doesn't exist (HTTP 404)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:18
class Prusalink::Exceptions::NotFoundError < ::Prusalink::Exceptions::Error; end

# The printer doesn't implement this endpoint (HTTP 501)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:26
class Prusalink::Exceptions::NotImplementedError < ::Prusalink::Exceptions::Error; end

# The printer is busy or not ready (HTTP 503)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:28
class Prusalink::Exceptions::ServiceUnavailableError < ::Prusalink::Exceptions::Error; end

# The printer did not open the connection or respond within the configured timeouts
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:36
class Prusalink::Exceptions::TimeoutError < ::Prusalink::Exceptions::ConnectionError; end

# Any other unexpected HTTP status
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:30
class Prusalink::Exceptions::UnknownError < ::Prusalink::Exceptions::Error; end

# The uploaded media type isn't supported (HTTP 415)
#
# pkg:gem/prusalink#lib/prusalink/exceptions.rb:22
class Prusalink::Exceptions::UnsupportedMediaTypeError < ::Prusalink::Exceptions::Error; end

# Files and folders on the printer's storages (USB drive, local storage, SD card).
#
# `storage` is the storage's name, with or without slashes ("usb", "/usb" or "local").
# `path` is relative to the storage, with or without a leading slash. Spaces and other special
# characters are URL-encoded for you.
#
# @example
#   folder = Prusalink::Files.get(storage: "usb")
#   folder.children.map(&:display_name) # => ["benchy.gcode", "prints"]
#
#   Prusalink::Files.upload("benchy.gcode", storage: "usb", path: "prints/benchy.gcode", print_after_upload: true)
#   Prusalink::Files.exists?(storage: "usb", path: "prints/benchy.gcode") # => true
#   Prusalink::Files.delete(storage: "usb", path: "prints/benchy.gcode")
