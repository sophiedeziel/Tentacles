    #
    # pkg:gem/prusalink#lib/prusalink/files.rb:104
    sig { override.params(storage: ::String, path: ::String, force: T::Boolean).returns(T::Boolean) }
    def delete(storage:, path:, force: T.unsafe(nil)); end

    # Whether a file or folder exists.
    #
    # @param storage [String]   the storage's name, e.g. "usb"
    # @param path [String]      path to the file or folder
    # @return [Boolean]
    #
