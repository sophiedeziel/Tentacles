  # pkg:gem/prusalink#lib/prusalink/deserializable.rb:427
  sig { params(field: ::Symbol, klass: T.untyped).void }
  def nested(field, klass); end

  # @return [Hash<Symbol, Class>] Mapping of field names to classes for nested object conversion
  # @api private
  #
  # pkg:gem/prusalink#lib/prusalink/deserializable.rb:398
  sig { returns(T::Hash[::Symbol, T.untyped]) }
  def nested_objects; end

