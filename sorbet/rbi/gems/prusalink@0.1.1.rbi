  def path; end

  # pkg:gem/prusalink#lib/prusalink/storage.rb:59
  def print_files; end

  # pkg:gem/prusalink#lib/prusalink/storage.rb:59
  def read_only; end

  # @return [Boolean] whether the storage is read only
  #
  # pkg:gem/prusalink#lib/prusalink/storage.rb:83
  sig { returns(T::Boolean) }
  def read_only?; end

  # pkg:gem/prusalink#lib/prusalink/storage.rb:59
  def storage_type; end

  # pkg:gem/prusalink#lib/prusalink/storage.rb:59
  def system_files; end

  # pkg:gem/prusalink#lib/prusalink/storage.rb:59
  def total_space; end

  class << self
    # Retrieve every file storage of the printer.
    #
    # @return [Array<Storage>]
    # @raise [Prusalink::Exceptions::Error] if the request fails
    #
    # pkg:gem/prusalink#lib/prusalink/storage.rb:70
    sig { returns(T::Array[::Prusalink::Storage]) }
    def list; end
  end
end

# The printer's current file transfer (upload or download).
#
# @example
#   transfer = Prusalink::Transfer.get # => nil when nothing is transferring
#   transfer.transfer_type # => "FROM_WEB"
#   transfer.progress      # => 42.25
#   transfer.stop
#
# pkg:gem/prusalink#lib/prusalink/transfer.rb:12
class Prusalink::Transfer < ::Prusalink::BaseResource
  include ::Prusalink::AutoInitializable
  include ::Prusalink::Deserializable
  extend ::Prusalink::AutoInitializable::ClassMethods
  extend ::Prusalink::Deserializable::ClassMethods

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def initialize(**kwargs); end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def display_name; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def extra; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def id; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def path; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def progress; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def size; end

  # Stop this transfer. See {Transfer.stop}.
  #
  # @return [Boolean] true on success
  # @raise [ArgumentError] if the printer didn't report the transfer's id
  #
  # pkg:gem/prusalink#lib/prusalink/transfer.rb:101
  sig { returns(T::Boolean) }
  def stop; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def time_remaining; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def time_transferring; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def to_print; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def transfer_type; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def transferred; end

  # pkg:gem/prusalink#lib/prusalink/transfer.rb:70
  def url; end

  class << self
    # Retrieve the current transfer.
    #
    # @return [Transfer, nil] nil when nothing is transferring (the printer answers 204 No Content)
    # @raise [Prusalink::Exceptions::Error] if the request fails
    #
    # pkg:gem/prusalink#lib/prusalink/transfer.rb:81
    sig { returns(T.nilable(::Prusalink::Transfer)) }
    def get; end

    # Stop the transfer with the given id.
    #
    # @param id [Integer] The transfer's id
    # @return [Boolean] true on success
    # @raise [Prusalink::Exceptions::NotFoundError] if no transfer has this id
    # @raise [Prusalink::Exceptions::ConflictError] if the transfer can't be stopped
    #
    # pkg:gem/prusalink#lib/prusalink/transfer.rb:92
    sig { params(id: ::Integer).returns(T::Boolean) }
    def stop(id); end
  end
end

# Common type aliases for use with auto_attr and Sorbet signatures.
#
# pkg:gem/prusalink#lib/prusalink/types.rb:6
module Prusalink::Types; end

# Job states reported by /api/v1/job
# PRINTING, PAUSED, FINISHED, STOPPED, ERROR
#
# pkg:gem/prusalink#lib/prusalink/types.rb:25
Prusalink::Types::JobState = String

# Printer states reported by /api/v1/status
# IDLE, BUSY, PRINTING, PAUSED, FINISHED, STOPPED, ERROR, ATTENTION, READY
#
# pkg:gem/prusalink#lib/prusalink/types.rb:21
Prusalink::Types::PrinterState = String

# This gem's version
#
# pkg:gem/prusalink#lib/prusalink/version.rb:6
Prusalink::VERSION = T.let(T.unsafe(nil), String)

# Tapioca::Dsl::Compilers::AutoInitializable is left out: the octoprint gem defines the same compiler and its RBI
# already declares it (Sorbet rejects the duplicate type member). Remove it again after `bin/tapioca gem prusalink`.
