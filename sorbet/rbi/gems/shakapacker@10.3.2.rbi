  def javascript_pack_tag_queue; end

  # pkg:gem/shakapacker#lib/shakapacker/helper.rb:400
  def lookup_integrity(source); end

  # pkg:gem/shakapacker#lib/shakapacker/helper.rb:404
  def lookup_source(source); end

