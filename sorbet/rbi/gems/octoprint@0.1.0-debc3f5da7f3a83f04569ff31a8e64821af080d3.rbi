  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def command; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def commands; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def confirm; end

  # Whether this is a container grouping other controls.
  #
  # @return [Boolean] true if the control has children
  #
  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:115
  sig { returns(T::Boolean) }
  def container?; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def enabled; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def extra; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def input; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def javascript; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def key; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def layout; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def name; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def offset; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def regex; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def script; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def template; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def template_key; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def type; end

  # pkg:gem/octoprint#lib/octoprint/printer/custom_control.rb:104
  def width; end
end

