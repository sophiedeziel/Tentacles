  # pkg:gem/octoprint#lib/octoprint/system_commands/command.rb:39
  def resource; end

  # pkg:gem/octoprint#lib/octoprint/system_commands/command.rb:39
  def source; end
end

# Common type aliases for use with auto_attr and Sorbet signatures.
#
# This module provides convenient type aliases for commonly used types
# in the OctoPrint API. These can be used with auto_attr or in regular
# Sorbet type annotations.
#
# @example Using with auto_attr
#   class User
#     include AutoInitializable
#
#     auto_attr :name, type: String, nilable: false
#     auto_attr :email, type: Types::NilableString   # Alternative syntax
#     auto_attr :tags, type: Types::StringArray
#     auto_attr :metadata, type: Types::Hash
#
#     auto_initialize!
#   end
#
# @example Using in Sorbet signatures
#   sig { params(data: Types::Hash).returns(Types::NilableString) }
#   def process_data(data)
#     data[:name]
#   end
#
# pkg:gem/octoprint#lib/octoprint/types.rb:28
module Octoprint::Types; end

# Baud rate for serial connections
# @example 115200, 250000, 500000
#
# pkg:gem/octoprint#lib/octoprint/types.rb:136
Octoprint::Types::BaudRate = Integer

# Bed temperature in Celsius
# @example 60.0, 80.5
#
# pkg:gem/octoprint#lib/octoprint/types.rb:114
Octoprint::Types::BedTemperature = Float

# Connection Types
# Connection state string
# @example "Connected", "Disconnected", "Connecting"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:132
Octoprint::Types::ConnectionState = String

# Number of extruders
# @example 1, 2, 4
#
# pkg:gem/octoprint#lib/octoprint/types.rb:110
Octoprint::Types::ExtruderCount = Integer

# File Types
# A file path string
# @example "/path/to/file.gcode"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:75
Octoprint::Types::FilePath = String

# File size in bytes
# @example 1048576
#
# pkg:gem/octoprint#lib/octoprint/types.rb:79
Octoprint::Types::FileSize = Integer

# Network Types
# A hostname or IP address
# @example "octopi.local" or "192.168.1.100"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:93
Octoprint::Types::Hostname = String

# ISO 8601 formatted date string
# @example "2023-12-31T12:00:00Z"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:88
Octoprint::Types::Iso8601String = String

# Job Types
# Job state string
# @example "Printing", "Paused", "Operational"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:119
Octoprint::Types::JobState = String

# A port number
# @example 80, 443, 5000
#
# pkg:gem/octoprint#lib/octoprint/types.rb:97
Octoprint::Types::Port = Integer

# Print time in seconds
# @example 3600, 7200
#
# pkg:gem/octoprint#lib/octoprint/types.rb:127
Octoprint::Types::PrintTime = Integer

# Printer Types
# A printer identifier
# @example "ender3", "_default"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:106
Octoprint::Types::PrinterId = String

# Print progress percentage (0.0 to 100.0)
# @example 45.5, 100.0
#
# pkg:gem/octoprint#lib/octoprint/types.rb:123
Octoprint::Types::ProgressPercent = Float

# Serial port name
# @example "/dev/ttyUSB0", "COM3"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:140
Octoprint::Types::SerialPort = String

# Time Types
# Unix timestamp (seconds since epoch)
# @example 1640995200
#
# pkg:gem/octoprint#lib/octoprint/types.rb:84
Octoprint::Types::UnixTimestamp = Integer

# A URL string
# @example "https://octopi.local/api/version"
#
# pkg:gem/octoprint#lib/octoprint/types.rb:101
Octoprint::Types::Url = String

# Alias for backward compatibility
# @deprecated Use Octoprint::Access::User instead
#
# pkg:gem/octoprint#lib/octoprint.rb:64
Octoprint::User = Octoprint::Access::User

# Utility operations for testing paths, URLs, and connectivity.
#
# @example Test a path
#   result = Octoprint::Util.test_path(path: "/tmp/test")
#   puts "Exists: #{result.exists}"
#
# @see https://docs.octoprint.org/en/1.11.2/api/util.html
#
# pkg:gem/octoprint#lib/octoprint/util.rb:12
class Octoprint::Util < ::Octoprint::BaseResource
  include ::Octoprint::AutoInitializable
  include ::Octoprint::Deserializable
  extend ::Octoprint::AutoInitializable::ClassMethods
  extend ::Octoprint::Deserializable::ClassMethods

  # pkg:gem/octoprint#lib/octoprint/util.rb:35
  def initialize(**kwargs); end

  # pkg:gem/octoprint#lib/octoprint/util.rb:35
  def exists; end

  # pkg:gem/octoprint#lib/octoprint/util.rb:35
  def extra; end

  # pkg:gem/octoprint#lib/octoprint/util.rb:35
  def result; end

  # pkg:gem/octoprint#lib/octoprint/util.rb:35
  def status; end

  class << self
    # Test network address
    #
    # @param [String] address Optional address (defaults to client address)
    # @return [Util]
    #
    # pkg:gem/octoprint#lib/octoprint/util.rb:150
    sig { params(address: T.nilable(::String)).returns(::Octoprint::Util) }
    def test_address(address: T.unsafe(nil)); end

    # Test file system paths
    #
    # @param [String] path Mandatory file system path
    # @param [String] check_type Optional (file/directory)
    # @param [String] check_access Optional permissions check
    # @param [Boolean] allow_create_dir Optional directory creation flag
    # @param [Boolean] check_writable_dir Optional directory writability test
    # @return [Util]
    #
    # pkg:gem/octoprint#lib/octoprint/util.rb:54
    sig do
      params(
        path: ::String,
        check_type: T.nilable(::String),
        check_access: T.nilable(::String),
        allow_create_dir: T.nilable(T::Boolean),
        check_writable_dir: T.nilable(T::Boolean)
      ).returns(::Octoprint::Util)
    end
    def test_path(path:, check_type: T.unsafe(nil), check_access: T.unsafe(nil), allow_create_dir: T.unsafe(nil), check_writable_dir: T.unsafe(nil)); end

    # Test DNS hostname resolution
    #
    # @param [String] name Mandatory hostname to resolve
    # @return [Util]
    #
    # pkg:gem/octoprint#lib/octoprint/util.rb:138
    sig { params(name: ::String).returns(::Octoprint::Util) }
    def test_resolution(name:); end

    # Test server connectivity
    #
    # @param [String] host Mandatory hostname or IP address
    # @param [Integer] port Mandatory port number
    # @param [String] protocol Optional protocol (default TCP)
    # @param [Float] timeout Optional timeout in seconds (default 3.05)
    # @return [Util]
    #
    # pkg:gem/octoprint#lib/octoprint/util.rb:124
    sig do
      params(
        host: ::String,
        port: ::Integer,
        protocol: T.nilable(::String),
        timeout: T.nilable(::Float)
      ).returns(::Octoprint::Util)
    end
    def test_server(host:, port:, protocol: T.unsafe(nil), timeout: T.unsafe(nil)); end

    # Test URL connectivity
    #
    # @param [String] url Mandatory URL to test
    # @param [String] method Optional HTTP method (default HEAD)
    # @param [Integer] timeout Optional timeout in seconds (default 3)
    # @param [Integer] status Optional expected status code
    # @param [String] auth_user Optional basic auth username
    # @param [String] auth_pass Optional basic auth password
    # @param [String] auth_digest Optional digest auth
    # @param [String] auth_bearer Optional bearer token
    # @param [String] content_type_whitelist Optional content type filter
    # @param [String] content_type_blacklist Optional content type exclusion
    # @return [Util]
    #
    # pkg:gem/octoprint#lib/octoprint/util.rb:92
    sig do
      params(
        url: ::String,
        method: T.nilable(::String),
        timeout: T.nilable(::Integer),
        status: T.nilable(::Integer),
        auth_user: T.nilable(::String),
        auth_pass: T.nilable(::String),
        auth_digest: T.nilable(::String),
        auth_bearer: T.nilable(::String),
        content_type_whitelist: T.nilable(::String),
        content_type_blacklist: T.nilable(::String)
      ).returns(::Octoprint::Util)
    end
    def test_url(url:, method: T.unsafe(nil), timeout: T.unsafe(nil), status: T.unsafe(nil), auth_user: T.unsafe(nil), auth_pass: T.unsafe(nil), auth_digest: T.unsafe(nil), auth_bearer: T.unsafe(nil), content_type_whitelist: T.unsafe(nil), content_type_blacklist: T.unsafe(nil)); end

    private

    # pkg:gem/octoprint#lib/octoprint/util.rb:105
    def build_url_test_params(url, options); end
  end
end

# This gem's version
#
# pkg:gem/octoprint#lib/octoprint/version.rb:6
Octoprint::VERSION = T.let(T.unsafe(nil), String)

# The Wizard API allows retrieval of registered wizard dialog data
# and completion of wizard dialogs.
#
# @see https://docs.octoprint.org/en/master/api/wizard.html OctoPrint Wizard API Documentation
#
# @example Get wizard data
#   wizards = Octoprint::Wizard.get
#   wizards.each do |name, data|
#     puts "#{name}: required=#{data[:required]}, ignored=#{data[:ignored]}"
#   end
#
# @example Complete wizard dialog
#   Octoprint::Wizard.finish(handled: ["corewizard", "softwareupdate"])
#
# pkg:gem/octoprint#lib/octoprint/wizard.rb:18
class Octoprint::Wizard < ::Octoprint::BaseResource
  class << self
    # Completes a wizard dialog by reporting which wizards were handled.
    #
    # Triggers the on_wizard_finish method across all registered wizard
    # plugins, passing information about which wizards were handled
    # versus skipped.
    #
    # @example Complete specific wizards
    #   Octoprint::Wizard.finish(handled: ["corewizard", "softwareupdate"])
    #
    # @param handled [Array<String>] List of wizard identifiers that were processed (not skipped)
    # @return [T::Boolean] true on success (204 No Content)
    # @raise [Octoprint::Exceptions::Error] if the request fails
    #
    # pkg:gem/octoprint#lib/octoprint/wizard.rb:55
    sig { params(handled: T::Array[::String]).returns(T.untyped) }
    def finish(handled:); end

    # Retrieves registered wizard data from the OctoPrint server.
    #
    # Returns a Hash mapping wizard identifiers to wizard data entries.
    # Each entry contains details about whether the wizard is required,
    # ignored, its version, and plugin-specific details.
    #
    # @example Get wizard data
    #   wizards = Octoprint::Wizard.get
    #   wizards.each do |name, data|
    #     puts "#{name}: required=#{data[:required]}"
    #   end
    #
    # @return [Hash] Wizard data keyed by wizard identifier
    # @raise [Octoprint::Exceptions::Error] if the request fails
    #
    # pkg:gem/octoprint#lib/octoprint/wizard.rb:38
    sig { returns(T::Hash[::Symbol, T.untyped]) }
    def get; end
  end
end

# pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:4
module Tapioca; end

# pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:5
module Tapioca::Dsl; end

# pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:6
module Tapioca::Dsl::Compilers; end

# Tapioca compiler for classes using AutoInitializable module.
#
# This compiler generates RBI files with proper Sorbet type signatures
# for classes that include the AutoInitializable module, replacing the
# need for dynamic code generation at runtime.
#
# pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:12
class Tapioca::Dsl::Compilers::AutoInitializable < ::Tapioca::Dsl::Compiler
  extend T::Generic

  ConstantType = type_member { { upper: Module } }

  # Generates RBI content for the AutoInitializable class.
  #
  # pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:35
  sig { override.void }
  def decorate; end

  private

  # Generates Sorbet type string for a configuration.
  #
  # pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:55
  def generate_sorbet_type(config); end

  class << self
    # Gather all classes that include AutoInitializable module.
    #
    # pkg:gem/octoprint#lib/tapioca/dsl/compilers/auto_initializable.rb:17
    sig { override.returns(T::Enumerable[::Module]) }
    def gather_constants; end
  end
end
